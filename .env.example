# ============================================================
# kaede photo 環境変数テンプレート
# このファイルをコピーして「.env」を作成し、各値を埋めてください。
# 本番環境では Netlify の「Site settings > Environment variables」に
# 同じキーと値を登録します（.env はアップロードしません）。
# ============================================================

# --- Resend（メール送信）-------------------------------------
# https://resend.com で取得した API キー
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 送信元アドレス（Resendで認証したドメインのアドレス）
# 例: kaede photo <booking@kaede-photo.com>
MAIL_FROM=kaede photo <booking@your-domain.com>

# 予約通知を受け取る、だいきさん本人のメールアドレス
OWNER_EMAIL=daiki@example.com

# --- Upstash Redis（レート制限）------------------------------
# https://console.upstash.com の Redis データベース詳細からコピー
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Notion（予約台帳）---------------------------------------
# https://www.notion.so/my-integrations で発行したシークレット
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxx

# 予約台帳データベースのID（共有したDBのURLから取得）
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- CORS（任意）---------------------------------------------
# 本番公開URL。未設定の場合は同一オリジンのみ許可。
# 例: https://kaede-photo.netlify.app
SITE_URL=https://your-site.netlify.app
